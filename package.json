{
  "name": "linkbio-workers",
  "version": "2.0.0",
  "description": "Personal Bio / Digital Card on Cloudflare Workers — Next.js + Tailwind + Kumo Admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:assets && next dev",
    "build": "npm run build:assets && next build",
    "build:themes": "node scripts/build-themes.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:assets": "npm run build:themes && npm run build:icons",
    "pretypecheck": "npm run build:assets",
    "build:worker": "npm run build:assets && opennextjs-cloudflare build",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.9.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-or-later"
}
